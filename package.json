{
  "name": "yachiyo-live2d-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Live2D Studio for Yachiyo AI VTuber tests.",
  "type": "module",
  "scripts": {
    "dev": "vite --config live2d-studio/vite.config.js --host 127.0.0.1 --port 5174",
    "build": "vite build --config live2d-studio/vite.config.js",
    "build:live2d-studio": "vite build --config live2d-studio/vite.config.js",
    "generate:yachiyo-memory-seeds": "node tools/memory/generate-yachiyo-memory-seeds.mjs ../yachiyo_novel_detailed_corpus.txt",
    "install:yachiyo-vts-parameters": "node tools/vtube-studio/install-yachiyo-model-parameters.mjs",
    "audit:yachiyo-vts-control": "node tools/vtube-studio/audit-yachiyo-vts-control.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "better-sqlite3": "^9.6.0",
    "vite": "^8.0.5",
    "vue": "^3.5.0"
  },
  "optionalDependencies": {
    "vosk": "^0.3.39"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
